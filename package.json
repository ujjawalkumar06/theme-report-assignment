{
  "name": "theme-report-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript validation of theme application, persistence and cross-module consistency for OomniEye staging",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright test tests/theme-report.spec.ts",
    "test:edge": "playwright test tests/theme-edge.spec.ts",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.2",
    "dotenv": "16.4.7",
    "typescript": "5.7.2"
  }
}
